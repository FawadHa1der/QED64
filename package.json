{
  "name": "qed64",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QED64 \u2014 a Lean 4 web editor running the real compiler client-side on WebAssembly Memory64, with Mathlib profiles.",
  "exports": {
    "./embed": {
      "types": "./frontend/src/embed/index.ts",
      "default": "./frontend/src/embed/index.ts"
    },
    "./workers/*": "./public/workers/*",
    "./pipeline/*": "./pipeline/*",
    "./embedding/closure.json": "./embedding/closure.json",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "docs/EMBEDDING.md",
    "embedding/closure.json",
    "frontend/src/embed/",
    "frontend/src/qed64-boot.ts",
    "frontend/src/resident-session.ts",
    "frontend/src/lsp-relay.ts",
    "src/install/profiles.ts",
    "src/runtime/client.ts",
    "src/runtime/snapshots.ts",
    "public/workers/lean.worker.js",
    "public/workers/lsp-frames.js",
    "public/workers/lsp-front-door.js",
    "public/workers/snapshot-prefetch.worker.js",
    "pipeline/toolchain/artifact-paths.mjs",
    "pipeline/toolchain/artifact-paths.d.mts",
    "pipeline/toolchain/chunk-runtime.mjs",
    "pipeline/toolchain/gate.mjs",
    "pipeline/toolchain/gen-exports.py",
    "pipeline/snapshot/bake-snapshot.mjs",
    "pipeline/snapshot/node-runner.mjs",
    "pipeline/snapshot/persistent-probe.mjs",
    "pipeline/snapshot/snapshot-probe.mjs",
    "pipeline/artifacts/inspect.mjs",
    "pipeline/artifacts/olean-imports.mjs",
    "pipeline/artifacts/olean-imports.d.mts",
    "pipeline/artifacts/pack.mjs",
    "pipeline/artifacts/unpack.mjs",
    "pipeline/release/verify-release.mjs",
    "tests/adversarial/kernel-probes/is-module.lean",
    "tests/adversarial/kernel-probes/module-file.lean",
    "tests/adversarial/kernel-probes/private-default.lean",
    "tests/adversarial/kernel-probes/rpc-attr.lean"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "tsc --noEmit && npm run build:site",
    "preview": "node scripts/serve-dist.mjs",
    "pretest": "if [ -d frontend/node_modules ]; then npm run typecheck:site; else echo \"pretest: frontend/node_modules absent — skipping typecheck:site (run: npm --prefix frontend ci)\"; fi",
    "test": "vitest run --exclude '**/integration/**'",
    "test:watch": "vitest --exclude '**/integration/**'",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run",
    "sync:artifacts": "node pipeline/release/sync-artifacts.mjs",
    "runner": "node pipeline/snapshot/node-runner.mjs",
    "bake:snapshot": "node pipeline/snapshot/bake-snapshot.mjs",
    "pack": "node pipeline/artifacts/pack.mjs",
    "inspect:pack": "node pipeline/artifacts/inspect.mjs",
    "verify:release": "node pipeline/release/verify-release.mjs",
    "promote:staging": "node pipeline/release/promote-staging.mjs",
    "build:site": "npm --prefix frontend run build",
    "typecheck:site": "npm --prefix frontend exec -- tsc -p frontend --noEmit",
    "preview:prod": "node scripts/serve-dist.mjs",
    "test:adversarial": "node tests/adversarial/run.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@lezer/highlight": "^1.2.0",
    "@types/node": "^26.2.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.125.0"
  }
}