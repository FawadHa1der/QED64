--- a/src/emscripten-exports.seed.txt
+++ b/src/emscripten-exports.seed.txt
@@ -776,8 +776,6 @@ _lean_uv_udp_set_multicast_ttl
 _lean_uv_udp_set_ttl
 _lean_uv_uptime
 _lean_wasm_compile
-_lean_wasm_lsp_init
-_lean_wasm_lsp_send
 _lean_wasm_load_snapshot
 _lean_wasm_load_snapshot_mem
 _lean_wasm_reset
