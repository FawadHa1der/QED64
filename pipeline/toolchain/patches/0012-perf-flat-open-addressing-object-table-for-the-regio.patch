From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: QED64 Toolchain <qed64-toolchain@localhost>
Date: Fri, 21 Aug 2026 16:32:48 -0400
Subject: [PATCH 12/19] perf: flat open-addressing object table for the region
 compactor

This PR cuts the memory the compactor spends tracking already-visited objects by roughly 2.5x, which lets whole-environment saves of Mathlib-scale environments fit in a 16 GiB wasm64 address space.

The seen-object table was a node-based unordered_map: ~56 bytes per entry, i.e. ~5 GB for the ~10^8 objects a whole-Mathlib environment contains, on top of the environment itself and the >2 GiB output buffer. A flat open-addressing table keyed by object pointer (16 bytes per slot, linear probing, grown at 0.7 load) holds the same mapping in ~2 GB and walks with fewer cache misses. Behaviour is unchanged: pointer-identity dedup with the same insert/find semantics.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 src/runtime/compact.cpp | 53 +++++++++++++++++++++++++++++++++++++----
 src/runtime/compact.h   | 40 ++++++++++++++++++++++++++++++-
 2 files changed, 87 insertions(+), 6 deletions(-)

diff --git a/src/runtime/compact.cpp b/src/runtime/compact.cpp
index 4a17b45..73e5ac9 100644
--- a/src/runtime/compact.cpp
+++ b/src/runtime/compact.cpp
@@ -145,6 +145,48 @@ std::vector<lib_info> object_compactor::used_libs() const {
     return result;
 }
 
+object_offset_table::object_offset_table() {
+    m_mask = (1u << 16) - 1;
+    m_slots = static_cast<slot *>(calloc(m_mask + 1, sizeof(slot)));
+    if (m_slots == nullptr)
+        throw exception("object compactor: failed to allocate the object table");
+}
+
+object_offset_table::~object_offset_table() {
+    free(m_slots);
+}
+
+void object_offset_table::grow() {
+    size_t old_cap = m_mask + 1;
+    slot * old = m_slots;
+    size_t new_cap = old_cap * 2;
+    slot * fresh = static_cast<slot *>(calloc(new_cap, sizeof(slot)));
+    if (fresh == nullptr)
+        throw exception((sstream() << "object compactor: out of memory growing the object table to "
+                         << new_cap << " slots").str());
+    m_slots = fresh;
+    m_mask = new_cap - 1;
+    for (size_t j = 0; j < old_cap; j++) {
+        if (old[j].m_key == nullptr) continue;
+        size_t i = hash(old[j].m_key) & m_mask;
+        while (m_slots[i].m_key != nullptr) i = (i + 1) & m_mask;
+        m_slots[i] = old[j];
+    }
+    free(old);
+}
+
+void object_offset_table::insert(object * o, object_offset off) {
+    lean_assert(o != nullptr);
+    if ((m_size + 1) * 10 > (m_mask + 1) * 7) grow();
+    size_t i = hash(o) & m_mask;
+    for (;;) {
+        slot & s = m_slots[i];
+        if (s.m_key == nullptr) { s.m_key = o; s.m_val = off; m_size++; return; }
+        if (s.m_key == o) { s.m_val = off; return; }
+        i = (i + 1) & m_mask;
+    }
+}
