 object_compactor::object_compactor(void * base_addr, std::vector<region_view> dep_regions,
                                    bool allow_closures):
     m_max_sharing_table(new max_sharing_table(this)),
@@ -215,7 +257,7 @@ void * object_compactor::alloc(size_t sz) {
